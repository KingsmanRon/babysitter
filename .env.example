# ─── PayFast Configuration ───────────────────────────────────────────
# Get your credentials from https://www.payfast.co.za → Settings → Integration
# These are SERVER-SIDE only (used by API routes, never exposed to the browser)
PAYFAST_MERCHANT_ID=10000100
PAYFAST_MERCHANT_KEY=46f0cd694581a
PAYFAST_PASSPHRASE=
PAYFAST_SANDBOX=true

# ─── Site Configuration ─────────────────────────────────────────────
# Your deployed domain (used for PayFast return/notify URLs)
SITE_URL=http://localhost:5173

# ─── EmailJS Configuration ──────────────────────────────────────────
# Get your public key from https://www.emailjs.com → Account → General
# This is a VITE_ prefixed var so it's available in the browser
VITE_EMAILJS_PUBLIC_KEY=YOUR_EMAILJS_PUBLIC_KEY
